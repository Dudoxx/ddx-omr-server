# ddx-omr-server — copy to .env and set DDX_OMR_API_KEY.
# The service refuses to start with an empty key.

# Inbound API key (X-API-Key). Same KEY name as ddx-vision: deploy shares one
# value per key name across env files.
DDX_OMR_API_KEY=

# Bind address and port. 11513 is the only port this service takes.
HOST=127.0.0.1
OMR_PORT=11513
LOG_LEVEL=info

# Comma-separated CORS origins. Empty = no cross-origin caller (fail closed).
CORS_ORIGINS=

# Weights. fetch-weights.sh writes models/omr_model.onnx; a SHA-256 mismatch
# refuses to start.
OMR_MODEL_PATH=models/omr_model.onnx
OMR_MODEL_SHA256=ada735da9eef990edc82e0c98c0621426b8b85bc35f204e3256f7ea89057e115
OMR_MODEL_REVISION=046c24e341099033cc565fa5ff0fbaea01fde938

# Request limits.
OMR_MAX_BOXES=2000
OMR_MAX_IMAGE_BYTES=26214400

# Preprocess defaults (a request may override pad and otsu).
OMR_DEFAULT_PAD=0.35
OMR_DEFAULT_OTSU=true

# AGPL-3.0 section 13: the public source of THIS service, served at GET /source.
# REQUIRED — the service refuses to start without it.
OMR_SOURCE_URL=
